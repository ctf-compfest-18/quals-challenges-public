# ==================== COPPERSMITH (for refining p approximation) ====================

def coppersmith_howgrave_univariate(pol, modulus, beta, mm, tt, XX):
    """
    Coppersmith revisited by Seck et al.

    finds a solution if:
    * b|modulus, b >= modulus^beta , 0 < beta <= 1
    * |x| < XX

    # Copyright : Michel Seck
    # Github : https://github.com/Fayeabdoulaye/generalized_wiener_type_attacks

    """
    dd = pol.degree()
    nn = dd * mm + tt
    if not 0 < beta <= 1:
        raise ValueError("beta should belongs in (0, 1]")
    if not pol.is_monic():
        raise ArithmeticError("Polynomial must be monic.")

    polZ = pol.change_ring(ZZ)
    x = polZ.parent().gen()
    gg = []
    for ii in range(mm):
        for jj in range(dd):
            gg.append((x * XX)**jj * modulus**(mm - ii) * polZ(x * XX)**ii)
    for ii in range(tt):
        gg.append((x * XX)**ii * polZ(x * XX)**mm)

    BB = Matrix(ZZ, nn)
    for ii in range(nn):
        for jj in range(ii+1):
            BB[ii, jj] = gg[ii][jj]
    BB = BB.LLL()
    new_pol = 0
    for ii in range(nn):
        new_pol += x**ii * BB[0, ii] / XX**ii
    potential_roots = new_pol.roots()
    roots = []
    for root in potential_roots:
        if root[0].is_integer():
            result = polZ(ZZ(root[0]))
            if gcd(modulus, result) >= modulus^beta:
                roots.append(ZZ(root[0]))
    return roots


def get_p(N, pa):
    """Returns a factor p of N or None given N = pq and an approximation of p."""
    F.<x> = PolynomialRing(Zmod(N), implementation='NTL');
    pol = x - pa
    dd = pol.degree()
    beta = 0.5
    epsilon = beta / 7
    mm = ceil(beta**2 / (dd * epsilon))
    tt = floor(dd * mm * ((1/beta) - 1))
    XX = ceil(N**((beta**2/dd) - epsilon))
    roots = coppersmith_howgrave_univariate(pol, N, beta, mm, tt, XX)
    if roots:
        return pa - roots[0]


# ==================== LATTICE UTILITIES ====================
# Based on https://github.com/mseckept/generalized-lattice-attack

def create_lattice(pr, shifts, bounds, order="invlex", sort_shifts_reverse=False, sort_monomials_reverse=False):
    if pr.ngens() > 1:
        pr_ = pr.change_ring(ZZ, order=order)
        shifts = [pr_(shift) for shift in shifts]
    monomials = set()
    for shift in shifts:
        monomials.update(shift.monomials())
    shifts.sort(reverse=sort_shifts_reverse)
    monomials = sorted(monomials, reverse=sort_monomials_reverse)
    L = matrix(ZZ, len(shifts), len(monomials))
    for row, shift in enumerate(shifts):
        for col, monomial in enumerate(monomials):
            L[row, col] = shift.monomial_coefficient(monomial) * monomial(*bounds)
    monomials = [pr(monomial) for monomial in monomials]
    return L, monomials


def reduce_lattice(L, delta=0.8):
    start_time = time.perf_counter()
    L_reduced = L.LLL(delta)
    elapsed = time.perf_counter() - start_time
    print(f"    LLL ({L.nrows()}x{L.ncols()}) done in {elapsed:.1f}s")
    return L_reduced


def reconstruct_polynomials(B, f, modulus, monomials, bounds, preprocess_polynomial=lambda x: x, divide_gcd=False):
    divide_original = f is not None
    polynomials = []
    for row in range(B.nrows()):
        polynomial = 0
        for col, monomial in enumerate(monomials):
            if B[row, col] == 0:
                continue
            assert B[row, col] % monomial(*bounds) == 0
            polynomial += B[row, col] * monomial // monomial(*bounds)
        polynomial = preprocess_polynomial(polynomial)
        if divide_original and polynomial % f == 0:
            polynomial //= f
        if divide_gcd:
            for i in range(len(polynomials)):
                g = gcd(polynomial, polynomials[i])
                if g != 1 and g.is_constant():
                    polynomial //= g
                    polynomials[i] //= g
        if polynomial.is_constant():
            continue
        polynomials.append(polynomial)
    return polynomials


def find_roots_gcd(pr, polynomials):
    if pr.ngens() != 2:
        return
    x, y = pr.gens()
    for i in range(len(polynomials)):
        for j in range(i):
            g = gcd(polynomials[i], polynomials[j])
            if g.degree() == 1 and g.nvariables() == 2 and g.constant_coefficient() == 0:
                a = int(g.monomial_coefficient(x))
                b = int(g.monomial_coefficient(y))
                yield {x: b, y: a}
                yield {x: -b, y: a}


def find_roots_groebner(pr, polynomials):
    gens = pr.gens()
    s = Sequence(polynomials, pr.change_ring(QQ, order="lex"))
    G = s.groebner_basis()
    if len(G) == len(gens):
        roots = {}
        for polynomial in G:
            vars_in_poly = polynomial.variables()
            if len(vars_in_poly) == 1:
                v = vars_in_poly[0]
                for root in polynomial.univariate_polynomial().roots(ring=ZZ, multiplicities=False):
                    roots[v] = int(root)
        if len(roots) == len(gens):
            yield roots
            return
    # Fallback: substitution
    if len(G) > 0 and len(gens) == 2:
        x, y = gens
        for polynomial in G:
            if polynomial.degree(x) == 0 and polynomial.degree(y) > 0:
                for root_y in polynomial.univariate_polynomial().roots(ring=ZZ, multiplicities=False):
                    for polynomial2 in G:
                        if polynomial2.degree(x) > 0:
                            p2_sub = polynomial2.subs({y: root_y})
                            for root_x in p2_sub.univariate_polynomial().roots(ring=ZZ, multiplicities=False):
                                if root_x != 0 and root_y != 0:
                                    yield {x: int(root_x), y: int(root_y)}


def find_roots_resultants(pr, polynomials):
    if pr.ngens() != 2:
        return
    x, y = pr.gens()
    for i in range(len(polynomials)):
        for j in range(i):
            try:
                res = polynomials[i].resultant(polynomials[j], y)
                if res.is_constant():
                    continue
                for root_x, _ in res.univariate_polynomial().roots():
                    root_x = int(root_x)
                    if root_x == 0:
                        continue
                    for polynomial in polynomials:
                        p_sub = polynomial.subs({x: root_x})
                        if p_sub.is_constant():
                            continue
                        for root_y, _ in p_sub.univariate_polynomial().roots():
                            root_y = int(root_y)
                            if root_y != 0:
                                yield {x: root_x, y: root_y}
            except Exception:
                continue


def find_roots(pr, polynomials, method="groebner"):
    if method == "groebner":
        return find_roots_groebner(pr, polynomials)
    elif method == "resultants":
        return find_roots_resultants(pr, polynomials)
    elif method == "gcd":
        return find_roots_gcd(pr, polynomials)


# ==================== LATTICE ATTACK (Method 2) ====================
# Reference: https://github.com/mseckept/generalized-lattice-attack

def get_function_h(r, C, N):
    pr = ZZ["x", "y"]
    x, y = pr.gens()
    if r == 1: return x*(y - (N + 1)) - C
    if r == 2: return x*(y**2 - (N-1)**2) - C
    if r == 3: return x*(y**3 - 3*N*y - (N**3+1)) - C
    if r == 4: return x*(y**4 + 4*N*y**2 - (N**2-1)**2) - C
    if r == 5: return x*(y**5 - 5*N*y**3 + 5*N**2*y - (N**5+1)) - C
    if r == 6: return x*(y**6 + 6*N*y**4 + 9*N**2*y**2 - (N**3-1)**2) - C
    if r == 7: return x*(y**7 - 7*N*y**5 + 14*N**2*y**3 - 7*N**3*y - (N**7+1)) - C
    if r == 8: return x*(y**8 + 8*N*y**6 + 20*N**2*y**4 + 16*N**3*y**2 - (N**4-1)**2) - C
    if r == 9: return x*(y**9 - 9*N*y**7 + 27*N**2*y**5 - 30*N**3*y**3 + 9*N**4*y - (N**9+1)) - C
    if r == 10: return x*(y**10 + 10*N*y**8 + 35*N**2*y**6 + 50*N**3*y**4 + 25*N**4*y**2 - (N**5-1)**2) - C
    raise NotImplementedError(f"n={r} not supported")


def modular_bivariate(N, e, delta, s, C=-1, n=10, roots_method="groebner"):
    """
    Bivariate lattice attack on generalized RSA.
    Finds (v, p±q) where e*d + C = v * phi_n.
    """
    fr = ZZ["x", "y"]
    x, y = fr.gens()
    f = get_function_h(n, C, N)
    f = f.change_ring(ZZ)

    pr = ZZ["x", "y", "z"]
    x, y, z = pr.gens()
    qr = pr.quotient((x * y ** n - C) - z)
    RF = RealField(3 * N.bit_length())
    X = int(6 * e * RF(N) ** delta / (N ** n))
    Y = int(2 * sqrt(RF(N)))
    Z = X * Y ** n + 1

    tau = 1
    shifts = []

    for u in range(s + 1):
        for i in range(u + 1):
            for j in range(n):
                xshift = x ** (u - i) * y ** j * f ** i * e ** (s - i)
                xshift = qr(xshift).lift()
                shifts.append(xshift)

    for u in range(s + 1):
        for j in range(n, n + floor(tau * u)):
            yshift = y ** j * f ** u * e ** (s - u)
            yshift = qr(yshift).lift()
            shifts.append(yshift)

    print(f"    Shifts: {len(shifts)}, generating lattice...")
    L, monomials = create_lattice(pr, shifts, [X, Y, Z])
    print(f"    Reducing lattice...")
    L = reduce_lattice(L)

    fr2 = f.parent()
    x, y = fr2.gens()
    polynomials = reconstruct_polynomials(
        L, f, e ** s, monomials, [X, Y, Z],
        preprocess_polynomial=lambda p: p(x, y, x * y ** n - C)
    )

    print(f"    Reconstructed {len(polynomials)} polynomials, finding roots ({roots_method})...")
    start_time = time.perf_counter()
    solutions = list(find_roots(fr2, polynomials, method=roots_method))
    elapsed = time.perf_counter() - start_time
    print(f"    Root-finding done in {elapsed:.1f}s, found {len(solutions)} solution(s)")

    for xy in solutions:
        x0 = xy[x]
        y0 = xy[y]
        if x0 != 0 and y0 != 0:
            return x0, abs(y0)
    return None


def factor_lattice(N, e, n=10, C=-1, method="groebner"):
    """Factor N using the generalized bivariate lattice attack (no mu needed)."""
    delta = RR(n / 4)
    for s in [2, 3, 4]:
        print(f"  [Lattice] s={s}, delta={float(delta):.2f}, n={n}")
        try:
            solution = modular_bivariate(N, e, delta, s, C=C, n=n, roots_method=method)
        except Exception as ex:
            print(f"    Error: {ex}")
            continue
        if solution is not None:
            _, y0 = solution
            y0 = abs(y0)
            # For even n: y0 = |p - q|, recover p and q
            z_val = isqrt(y0 ** 2 + 4 * N)
            p1 = (y0 + z_val) // 2
            p2 = (-y0 + z_val) // 2
            for cand in [p1, p2]:
                if cand > 1 and N % cand == 0:
                    return cand, N // cand
    return None, None


# ==================== CONTINUED FRACTION ATTACK (Method 1) ====================
# Reference: https://github.com/Fayeabdoulaye/generalized_wiener_type_attacks

def get_approx_p(Nsp1_square, N, e, x, y, prec):
    """Approximate p from continued fraction convergent x/y.

    For n=10: sqrt((N^5+1)^2 - e*x/y) ≈ p^5 + q^5
    Then p^5 = (s5 + sqrt(s5^2 - 4*N^5)) / 2, and p ≈ (p^5)^(1/5).
    """
    RF = RealField(prec)
    val = RF(Nsp1_square) - RF(e) * RF(x) / RF(y)
    if val < 0:
        return None
    s5 = sqrt(val)
    disc = s5 ** 2 - 4 * RF(N) ** 5
    if disc < 0:
        return None
    p5 = (s5 + sqrt(disc)) / 2
    pa = ZZ(floor(p5 ** (RF(1) / 5)))
    return pa


def factor_cf(N, e, n=10, mu_range=range(100, 1001)):
    """Factor N using continued fraction attack (tries multiple mu values)."""
    prec = 12 * N.bit_length()
    Nsp1_square = (N ** (n // 2) + 1) ** 2  # (N^5+1)^2 for n=10

    for mu in mu_range:
        r = (2 * mu ** 2 * e) / (
            2 * mu ** 2 * N ** n
            - (mu ** 2 + 1) ** 2 * N ** (n // 2)
            + 2 * mu ** 2
        )

        try:
            cf = r.continued_fraction()
        except Exception:
            continue

        for i, xy in enumerate(cf.convergents()[1:]):
            xv = xy.denominator()
            yv = xy.numerator()

            pa = get_approx_p(Nsp1_square, N, e, xv, yv, prec)
            if pa is None or pa <= 1:
                continue

            p = get_p(N, pa)
            if p and p > 1 and N % p == 0:
                q = N // p
                print(f"  [CF] Found with mu={mu}, convergent {i}")
                print(f"       p = {p}")
                print(f"       q = {q}")
                return p, q

    return None, None


# ==================== MAIN ====================

print("=" * 60)
print("Generalized Wiener Attack Solver (n=10)")
print("Based on mseckept/generalized-lattice-attack")
print("=" * 60)

p = q = None

# Method 1: Continued Fraction (faster when mu is known/guessable)
print("\n[*] Method 1: Continued Fraction Attack (mu brute-force 100..1000)")
p, q = factor_cf(N, e, n=n_param)

if p is None:
    # Method 2: Lattice Attack (no mu needed, more robust)
    print("\n[*] Method 2: Bivariate Lattice Attack (no mu needed)")
    p, q = factor_lattice(N, e, n=n_param, C=-1)

if p is None:
    print("\n[-] FAILED: Could not factor N with either method.")
    exit(1)

# ==================== DECRYPTION ====================
print(f"\n[+] Factoring successful!")
print(f"    p = {p}")
print(f"    q = {q}")





assert P == p
assert Q == q

n = n_param

# The challenge author used phi = (p^n-1)*(q^n-1) to compute e = inverse_mod(phi-d, phi).
# However, this phi is NOT a multiple of the true order of the group (Z/N)[x]/(x^n - r_val).
# The true order depends on the degrees of the irreducible factors of x^n - r_val mod p and q.
Fp = GF(p)
Fq = GF(q)
R_p.<x_p> = PolynomialRing(Fp)
R_q.<x_q> = PolynomialRing(Fq)

factors_p = (x_p^n - r_val).factor()
factors_q = (x_q^n - r_val).factor()

L_true = 1
for f, _ in factors_p:
    L_true = lcm(L_true, p^f.degree() - 1)
for f, _ in factors_q:
    L_true = lcm(L_true, q^f.degree() - 1)

print(f"    True group exponent L_true computed.")

d_rsa = inverse_mod(e, L_true)
print(f"    d_true = {d_rsa}")


Rp.<x> = PolynomialRing(Zmod(N))
Ap.<t> = Rp.quotient(x ^ n - r_val)
c_poly = Ap(c)
m_poly = c_poly ^ d_rsa
coeffs = list(m_poly.list())
while len(coeffs) < n:
    coeffs.append(0)

plain_chunks = []
for ci in coeffs:
    ci = int(ci)
    if ci == 0:
        continue
    blen = (ci.bit_length() + 7) // 8
    plain_chunks.append(ci.to_bytes(blen, "big"))

padded_flag = b"".join(plain_chunks)
pad_len = padded_flag[-1]
flag_asli = padded_flag[:-pad_len] if 1 <= pad_len <= 10 else padded_flag

print(f"\n[+] Flag: {flag_asli}")